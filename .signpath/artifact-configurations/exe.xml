<?xml version="1.0" encoding="utf-8"?>
<!-- SignPath artifact configuration "exe": the upload is a zip holding isoview.exe (the app, before the installers
     are made); sign it with Authenticode. -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file path="isoview.exe">
      <authenticode-sign/>
    </pe-file>
  </zip-file>
</artifact-configuration>
